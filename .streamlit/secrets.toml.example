# Copy to .streamlit/secrets.toml (git-ignored) or paste into Streamlit Cloud -> Settings -> Secrets.
# Fill in from the read-only service account key (DEPLOY.md, step 1). Never commit real values.
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
auth_uri = ""
token_uri = ""
auth_provider_x509_cert_url = ""
client_x509_cert_url = ""
universe_domain = ""
